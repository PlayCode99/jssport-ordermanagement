includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Level 7 currently reports ~100 findings, nearly all docblock generics on
    # framework types rather than defects; the few that are not are places where
    # the analyser wants a defensive null check or a dead-catch removed, which
    # would cost real safety. Level 3 is clean and enforced, so regressions are
    # caught from here; raise it a level at a time as the annotations are filled in.
    level: 3
